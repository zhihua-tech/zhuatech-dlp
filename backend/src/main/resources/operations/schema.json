      "type": "ID"
    },
    {
      "key": "sentBytes",
      "label": "窗口已外发字节",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000000000"
    },
    {
      "key": "requestedBytes",
      "label": "本次字节",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000000000"
    },
    {
      "key": "windowLimitBytes",
      "label": "窗口字节上限",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000000000"
    },
    {
      "key": "sensitive",
      "label": "包含敏感内容",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "destinationApproved",
      "label": "目的地已批准",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    }
  ],
  "columns": [
    {
      "key": "candidateWindowBytes",
      "label": "拟执行后窗口字节"
    },
    {
      "key": "remainingWindowBytes",
      "label": "候选剩余额度字节"
    },
    {
      "key": "overLimitBytes",
      "label": "超额度字节"
    }
  ],
  "description": "将同一窗口已外发和拟外发字节合并，区分超过额度、目的地未授权和敏感数据需复核；不拦截网络或外发文件。",
