{
  "slug": "dlp",
  "title": "数据外发审批与敏感等级预检",
  "fields": [
    {
      "key": "transfer_no",
      "label": "外发单",
      "type": "ID",
      "length": 200
    },
    {
      "key": "classification",
      "label": "敏感等级",
      "type": "ENUM",
      "length": 200,
      "options": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ]
    },
    {
      "key": "encrypted",
      "label": "加密",
      "type": "ENUM",
      "length": 200,
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "requester",
      "label": "申请人",
      "type": "ID",
      "length": 200
    },
    {
      "key": "approver",
      "label": "审批人",
      "type": "ID",
      "length": 200
    },
    {
      "key": "volume_mb",
      "label": "数据量MB",
      "type": "DECIMAL",
      "length": 200,
      "scale": 2
    }
  ],
  "unique": [
    [
      "transfer_no"
    ]
  ],
  "rules": [
    {
      "op": "IF_EQ",
      "args": [
        "classification",
        "RESTRICTED",
        "encrypted",
        "YES"
      ],
      "code": "ENCRYPTION_REQUIRED",
      "message": "受限数据要求加密",
      "bad": {
        "encrypted": "NO"
      }
    },
    {
      "op": "DIFFERENT",
      "args": [
        "requester",
        "approver"
      ],
      "code": "DLP_SELF_APPROVAL",
      "message": "外发申请人与审批人须不同",
      "bad": {
        "approver": "USER-01"
      }
    }
  ],
  "sampleCsv": "transfer_no,classification,encrypted,requester,approver,volume_mb\nDLP-001,RESTRICTED,YES,USER-01,USER-02,10\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
